  "common_gotchas": [
    "High springk values can oscillate out of control; reduce timeinc for stability.",
    "timepreroll still computes skipped simulation time.",
    "fixed is a point group field, not a boolean toggle.",
    "bounce and stick are hit menu values, not parameters."
  ],
