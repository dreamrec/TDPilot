{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "td_brain_execute|td_transaction_apply|mcp__.*__td_brain_execute|mcp__.*__td_transaction_apply",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-${CLAUDE_PROJECT_DIR:-.}}}\" python hooks/run_hook.py post-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-${CLAUDE_PROJECT_DIR:-.}}}\" python hooks/run_hook.py release-stop"
          }
        ]
      }
    ]
  }
}
