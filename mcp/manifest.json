{
  "schema_version": 1,
  "name": "TDPilot",
  "slug": "tdpilot",
  "version": "2.0.2",
  "repository": "https://github.com/dreamrec/TDPilot",
  "description": "MCP server for TouchDesigner with live graph control, diagnostics, safety, streaming, knowledge corpus, technique memory, typed patch sessions, and a correctness-first BrainPlan transaction layer.",
  "entrypoints": {
    "npm": {
      "command": "npx",
      "args": [
        "-y",
        "tdpilot"
      ]
    },
    "python": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "<repo-path>",
        "tdpilot"
      ]
    }
  },
  "defaults": {
    "env": {
      "TD_MCP_HOST": "127.0.0.1",
      "TD_MCP_PORT": "9981",
      "TD_MCP_WS_PORT": "9982"
    },
    "transport": "stdio"
  },
  "surface": {
    "tool_count": 111,
    "resource_template_count": 9,
    "static_resource_count": 4
  },
  "artifacts": {
    "td_component_tox": "td_component/tdpilot.tox",
    "profiles_dir": "mcp/profiles"
  }
}
