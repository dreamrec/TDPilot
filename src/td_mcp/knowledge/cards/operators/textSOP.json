  "common_gotchas": [
    "Installed font selection is machine-dependent; fontfile paths are more portable.",
    "fontfile disables the font menu.",
    "Open polygon output is wireframe-style outline geometry, not filled text.",
    "Use Python expression mode for complex escaped strings instead of relying on legacy parsing."
  ],
