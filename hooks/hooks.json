{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "td_brain_execute|td_transaction_apply|mcp__.*__td_brain_execute|mcp__.*__td_transaction_apply",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT}}/hooks/run_hook.py\" post-tool-use; fi"
          }
        ]
      }
    ]
  }
}
